{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-thread-reader": {
      "type": "stdio",
      "command": "python",
      "args": ["${PLUGIN_ROOT}/server/server.py"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
